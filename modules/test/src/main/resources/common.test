group: SwitchStatement
    case: SimpleMatch
        python:
            test: int = 0
            match a:
                case t:
                    test += 1
                case a:
                    test += 3
                case k:
                    test += 4
                case m:
                    test += 5
                case _:
                    test = 0

        java:
            int test = 0;
            switch (a) {
                case t:
                    test++;
                    break;
                case a:
                    test += 3;
                    break;
                case k:
                    test += 4;
                    break;
                case m:
                    test += 5;
                    break;
                default:
                    test = 0;
                    break;
            }

        c++:
            int test = 0;
            switch (a)
            {
                case t:
                    test++;
                    break;
                case a:
                    test += 3;
                    break;
                case k:
                    test += 4;
                    break;
                case m:
                    test += 5;
                    break;
                default:
                    test = 0;
                    break;
            }


    case: MatchWithAsExpression
        python:
            match a:
                case t:
                    test += 1
                case 345 as a:
                    test += a
                case _:
                    test = 0

        isolated java:
            switch (a) {
                case t:
                    test++;
                    break;
                case 345: {
                    int a = 345;
                    test += a;
                    break;
                }
                default:
                    test = 0;
                    break;
            }

        isolated c++:
            switch (a)
            {
                case t:
                    test++;
                    break;
                case 345:
                {
                    int a = 345;
                    test += a;
                    break;
                }
                default:
                    test = 0;
                    break;
            }



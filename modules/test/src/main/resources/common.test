            int[] args = new int[] {1, 2, 3, 4, 5};
        isolated python:
            args: list[int] = [1, 2, 3, 4, 5]
        c++:
            int args[] = {1, 2, 3, 4, 5};


    case: ArrayNewMultiDimensionWithInit
        java:
            int[][] args = new int[][] {{1, 2}, {3, 4}, {5, 6}};
        isolated python:
            args: list[list[int]] = [[1, 2], [3, 4], [5, 6]]
        c++:
            int args[][] = {{1, 2}, {3, 4}, {5, 6}};


    case: ArrayNewSingleDimensionWithoutInit
        java:
            int[] args = new int[35 + x.y()];
        isolated python:
            args: list[int] = [int() for _ in range(35 + x.y())]
        c++:
            int args[35 + x.y()];


    case: ArrayNewMultiDimensionWithoutInit
        java:
            int[][] args = new int[a][b];
        isolated python:
            args: list[list[int]] = [[int() for __ in range(b)] for _ in range(a)]
        c++:
            int args[a][b];


    case: ParenthesizedExpression
        python:
            (a + b * c) + 6 * (a := 3)

        c++:
            (a + b * c) + 6 * (a = 3);

        java:
            (a + b * c) + 6 * (a = 3);



    case[translationUnitMode="full"]: StandardEntryPointFromPython
        main python:
            from funcs import func
            a: int = 1

            def run():
                func(a)
                return 0

            if __name__ == "__main__":
                run()

        c++:
            #include "funcs/func.h"
            int a = 1;

            auto run()
            {
                func(a);
                return 0;
            }

            int main()
            {
                run();
                return 0;
            }

        java:
            package main;

            import funcs.func;

            public class Main {

                public static int a = 1;

                public static void main(String[] args) {
                    run();
                }
                public static Object run() {
                    func(a);
                    return 0;
                }

            }


    case[translationUnitMode="full"]: StandardEntryPointFromCpp

        main c++:
            #include "funcs/func.h"
            int a = 1;

            int run()
            {
                func(a);
                return 0;
            }

            int main()
            {
                run();
                return 0;
            }

        python:
            import funcs.func
            a: int = 1

            def run() -> int:
                func(a)
                return 0

            if __name__ == "__main__":
                run()

        java:
            package main;

            import funcs.func;

            public class Main {

                public static int a = 1;

                public static void main(String[] args) {
                    run();
                    return;
                }
                public static int run() {
                    func(a);
                    return 0;
                }

            }


    case[translationUnitMode="full"]: StandardEntryPointFromJava

        main java:
            class Main {
                public static int a = 1;

                public static int run() {
                    func(a);
                    return 0;
                }

                public static void main(String[] args) {
                    run();
                }
            }

        python:
            class Main:
                a: int = 1
                @staticmethod
                def run() -> int:
                    func(a)
                    return 0

                @staticmethod
                def main(args: list[str]) -> None:
                    run()

            if __name__ == "__main__":
                Main.main(None)

        c++:
            #include <string>
            #include <array>
            class Main
            {
                public:
                    static int a = 1;
                    static int run()
                {
                    func(a);
                    return 0;
                }
                    static void main(std::array<std::string> args)
                {
                    run();
                }
            };

group: ForeignLibraryImports
    case[translationUnitMode="procedural"]: JavaLibraryImportBecomesCppHeader
        main java:
            import java.util.ArrayList;
            class Helper {
                static void useList() {
                    ArrayList<Integer> a = new ArrayList<>();
                }
            }

        c++:
            #include <vector>
            class Helper
            {
                static void useList()
                {
                    ArrayList<int> a = new ArrayList<>();
                }
            };

        python:
            class Helper:
                @staticmethod
                def useList() -> None:
                    a: ArrayList[int] = ArrayList[]()

    case[translationUnitMode="procedural"]: JavaLibraryImportBecomesCppUnorderedMapHeader
        main java:
            import java.util.HashMap;
            class Helper {
                static void useMap() {
                    HashMap<String, Integer> m;
                }
            }

        c++:
            #include <unordered_map>
            #include <string>
            class Helper
            {
                static void useMap()
                {
                    HashMap<std::string, int> m;
                }
            };

    case[translationUnitMode="procedural"]: PythonLibraryImportBecomesCppHeader
        main python:
            import random
            x = random.random()

        c++:
            #include <random>
            auto x = random.random();

    case[translationUnitMode="procedural"]: JavaUnresolvedImportStaysLocalPath
        main java:
            import com.mycompany.Foo;
            class Helper {
                static void useFoo() {
                    Foo f;
                }
            }

        c++:
            #include "com/mycompany/Foo.h"
            class Helper
            {
                static void useFoo()
                {
                    Foo f;
                }
            };

    case[translationUnitMode="procedural"]: PythonOwnLibraryImportsRoundTrip
        python:
            import os
            import random
            from mypkg.util import helper

            x = os.getcwd()

        python:
            import os
            import random
            from mypkg.util import helper

            x = os.getcwd()

    case[translationUnitMode="procedural", silentlySkipUnknownImports=true]: PythonLibraryImportDroppedInJava
        main python:
            import random
            x = random.random()

        java:
            var x = random.random();

    case[translationUnitMode="procedural", silentlySkipUnknownImports=true]: UnmappedLibraryImportLeavesNoBlankLineInCpp
        main python:
            import json
            x = json.dumps({})

        c++:
            auto x = json.dumps({});


group: Exceptions
    case: TryCatch
        python:
            try:
                g()
            except ValueError as e:
                h()

        java:
            try {
                g();
            }
            catch (ValueError e) {
                h();
            }

        c++:
            try
            {
                g();
            }
            catch (const ValueError& e)
            {
                h();
            }


    case: TryCatchFinally
        python:
            try:
                g()
            except ValueError as e:
                h()
            finally:
                k()

        java:
            try {
                g();
            }
            catch (ValueError e) {
                h();
            }
            finally {
                k();
            }


    case: BareExcept
        main python:
            try:
                g()
            except:
                h()

        java:
            try {
                g();
            }
            catch (Exception e) {
                h();
            }

        c++:
            try
            {
                g();
            }
            catch (...)
            {
                h();
            }


    case: MultiCatch
        main java:
            try {
                g();
            }
            catch (IOError | ValueError e) {
                h();
            }

        python:
            try:
                g()
            except (IOError, ValueError) as e:
                h()

        c++:
            try
            {
                g();
            }
            catch (const IOError& e)
            {
                h();
            }
            catch (const ValueError& e)
            {
                h();
            }


    case: TryElse
        main python:
            try:
                g()
            except ValueError as e:
                h()
            else:
                m()

        java:
            boolean _try_else_1 = false;
            try {
                g();
                _try_else_1 = true;
            }
            catch (ValueError e) {
                h();
            }
            if (_try_else_1) {
                m();
            }

        c++:
            bool _try_else_1 = false;
            try
            {
                g();
                _try_else_1 = true;
            }
            catch (const ValueError& e)
            {
                h();
            }
            if (_try_else_1)
            {
                m();
            }


    case: TryElseFinally
        main python:
            try:
                g()
            except ValueError as e:
                h()
            else:
                m()
            finally:
                k()

        java:
            try {
                boolean _try_else_1 = false;
                try {
                    g();
                    _try_else_1 = true;
                }
                catch (ValueError e) {
                    h();
                }
                if (_try_else_1) {
                    m();
                }
            }
            finally {
                k();
            }


    case: Raise
        main c++:
            throw ValueError("x");

        java:
            throw ValueError("x");

        python:
            raise ValueError("x")


    case: BareRethrow
        main c++:
            try
            {
                g();
            }
            catch (...)
            {
                throw;
            }

        python:
            try:
                g()
            except:
                raise


group: ResourceContext
    case: TryWithResources
        main java:
            try (FileReader r = new FileReader("a")) {
                g(r);
            }

        python:
            with FileReader("a") as r:
                g(r)

        c++:
            {
                FileReader r = new FileReader("a");
                g(r);
                delete r;
            }


    case: WithStatement
        main python:
            with open("a") as f:
                g(f)

        java:
            try (var f = open("a")) {
                g(f);
            }

        c++:
            {
                auto f = open("a");
                g(f);
                delete f;
            }


    case: SeveralResources
        main python:
            with open("a") as f, open("b") as k:
                g(f, k)

        java:
            try (var f = open("a"); var k = open("b")) {
                g(f, k);
            }

        c++:
            {
                auto f = open("a");
                auto k = open("b");
                g(f, k);
                delete k;
                delete f;
            }


    case: ResourceWithoutName
        main python:
            with lock:
                g()

        java:
            try (lock) {
                g();
            }

        c++:
            {
                lock;
                g();
            }


    case: TryWithResourcesAndCatch
        main java:
            try (FileReader r = new FileReader("a")) {
                g(r);
            }
            catch (IOError e) {
                h();
            }

        python:
            try:
                with FileReader("a") as r:
                    g(r)
            except IOError as e:
                h()

        c++:
            try
            {
                FileReader r = new FileReader("a");
                g(r);
                delete r;
            }
            catch (const IOError& e)
            {
                h();
            }


group: ScopeBinding
    case: GlobalDeclarationWritesOuterVariable
        main python:
            counter = 0
            def bump():
                global counter
                counter = counter + 1

        java:
            int counter = 0;
            public static Object bump() {
                counter = counter + 1;
            }

        c++:
            int counter = 0;
            auto bump()
            {
                counter = counter + 1;
            }


    case: AssignmentWithoutDeclarationIsLocal
        main python:
            x = 1
            def f():
                x = 2
                return x

        java:
            int x = 1;
            public static Object f() {
                int x = 2;
                return x;
            }

        c++:
            int x = 1;
            auto f()
            {
                int x = 2;
                return x;
            }


group: GeneratorsAndIterators
    case: LoopFormGeneratorBecomesIteratorClass
        main python:
            def gen(n: int) -> Iterator[int]:
                i: int = 0
                while i < n:
                    yield i
                    i = i + 1

        java:
            class gen implements java.util.Iterator<Integer> {
                private int n;
                private int i;
                public gen(int n) {
                    this.n = n;
                    this.i = 0;
                }
                public boolean hasNext() {
                    return this.i < this.n;
                }

                public Integer next() {
                    int _value = this.i;
                    this.i = this.i + 1;
                    return _value;
                }

            }


    case: RangeFormGeneratorBecomesIteratorClass
        main python:
            def r(n: int) -> Iterator[int]:
                for i in range(n):
                    yield i * 2

        java:
            class r implements java.util.Iterator<Integer> {
                private int n;
                private int i;
                public r(int n) {
                    this.n = n;
                    this.i = 0;
                }
                public boolean hasNext() {
                    return this.i < this.n;
                }

                public Integer next() {
                    int _value = this.i * 2;
                    this.i = this.i + 1;
                    return _value;
                }

            }


    case: FlatFormGeneratorBecomesStateCounter
        main python:
            def flat() -> Iterator[int]:
                yield 1
                yield 2

        java:
            class flat implements java.util.Iterator<Integer> {
                private int _state;
                public flat() {
                    this._state = 0;
                }
                public boolean hasNext() {
                    return this._state < 2;
                }

                public Integer next() {
                    if (this._state == 0) {
                        this._state = 1;
                        return 1;
                    }
                    if (this._state == 1) {
                        this._state = 2;
                        return 2;
                    }
                    return null;
                }

            }


    case: GeneratorCallBecomesObjectCreation
        main python:
            def flat() -> Iterator[int]:
                yield 1

            g = flat()

        java:
            class flat implements java.util.Iterator<Integer> {
                private int _state;
                public flat() {
                    this._state = 0;
                }
                public boolean hasNext() {
                    return this._state < 1;
                }

                public Integer next() {
                    if (this._state == 0) {
                        this._state = 1;
                        return 1;
                    }
                    return null;
                }

            }
            var g = new flat();


    case: JavaIteratorClassBecomesPythonProtocol
        main java:
            class Counter implements java.util.Iterator<Integer> {
                private int i;
                public boolean hasNext() {
                    return this.i < 10;
                }
                public Integer next() {
                    return this.i;
                }
            }

        python:
            class Counter:
                i: int
                def hasNext(self) -> bool:
                    return self.i < 10

                def next(self) -> int:
                    return self.i

                def __iter__(self):
                    return self

                def __next__(self):
                    if not self.hasNext():
                        raise StopIteration
                    return self.next()

group: SimpleStatements
    case: VariableDeclaration
        python:
            a: int = 456

        java:
            int a = 456;

        c++:
            int a = 456;

    case: StackAllocatedObjectDeclaration
        main c++:
            Box a(1);
            Box b(1, x + 2);

        java:
            Box a = new Box(1);
            Box b = new Box(1, x + 2);

        python:
            a: Box = Box(1)
            b: Box = Box(1, x + 2)


    case: LocalVariableInference
        main c++:
            void run()
            {
                auto result = create();
            }

        java:
            public static void run() {
                var result = create();
            }


    case: JavaLocalVariableInference
        main java:
            class A {
                void run() {
                    var result = create();
                }
            }

        c++:
            class A
            {
                virtual void run()
                {
                    auto result = create();
                }
            };


    case: MultipleVariableDeclarationWithUnknownType
        python:
            a, b, c = 40, t, "Hello"

        java:
            Object a = 40, b = t, c = "Hello";

        c++:
            auto a = 40, b = t, c = "Hello";

    case: AugmentedAssignmentStmt
        python:
            a: int = 456
            a = 3
            a += 3
            a -= 3
            a *= b
            a >>= b
            a <<= b
            a /= 5
            a /= 6
            a %= t
            a &= b
            c |= t
            v ^= m

        java:
            int a = 456;
            a = 3;
            a += 3;
            a -= 3;
            a *= b;
            a >>= b;
            a <<= b;
            a /= 5;
            a /= 6;
            a %= t;
            a &= b;
            c |= t;
            v ^= m;

        c++:
            int a = 456;
            a = 3;
            a += 3;
            a -= 3;
            a *= b;
            a >>= b;
            a <<= b;
            a /= 5;
            a /= 6;
            a %= t;
            a &= b;
            c |= t;
            v ^= m;


    case: AssignmentStmt
        python:
            a: int = 456
            a = 3

        java:
            int a = 456;
            a = 3;

        c++:
            int a = 456;
            a = 3;

    case: ArrayDeclaration
        c++:
            int x[] = {1, 2, 3, 4, a};

        java:
            int[] x = new int[] {1, 2, 3, 4, a};

    case[translationUnitMode="procedural"]: ListDeclaration
        c++:
            #include <vector>
            std::vector<int> a = {1, 2, 3};

        java:
            java.util.ArrayList<Integer> a = new java.util.ArrayList<>(java.util.List.of(1, 2, 3));

        python:
            a: list[int] = [1, 2, 3]

    case: MultidimensionalArrayDeclaration
        main c++:
            int a[][20][] = new int[30][30][10];

        java:
            int[][][] a = new int[30][30][10];

    case: ConstDeclaration
        main c++:
            const float PI = 3.14f;

        python:
            PI: float = 3.14

        java:
            final float PI = 3.14f;

    case: PassStatement
        python:
            if a:
                pass

        java:
            if (a) {
            }

        c++:
            if (a)
            {
            }


    case: MultipleAssignment
        main python:
            a, b = 3, 45

        java:
            int a = 3, b = 45;

        c++:
            int a = 3, b = 45;


    case: ChainedAssignment
        main python:
            a = b = 1

        java:
            int a;
            int b;
            a = b = 1;

        c++:
            int a;
            int b;
            a = b = 1;


group: Conditions
    case: IfElseCompound
        python:
            k: int = 1
            if a > 0:
                a += 15
                k = x + 1

        java:
            int k = 1;
            if (a > 0) {
                a += 15;
                k = x + 1;
            }

        isolated c++:
            int k = 1;
            if (a > 0)
            {
                a += 15;
                k = x + 1;
            }


    case: OnlyIf
        python:
            if a >= 0:
                t()
                x()

        java:
            if (a >= 0) {
                t();
                x();
            }

        c++:
            if (a >= 0)
            {
                t();
                x();
            }


    case: NestedOnlyIfCompound
        python:
            if a > 0:
                if k:
                    print("a")
                    print("b")

        java:
            if (a > 0) {
                if (k) {
                    System.out.println("a");
                    System.out.println("b");
                }
            }

        c++:
            if (a > 0)
            {
                if (k)
                {
                    std::cout << "a" << std::endl;
                    std::cout << "b" << std::endl;
                }
            }


    case: OneAlternative
        python:
            if a:
                pass
            elif b:
                pass

        c++:
            if (a)
            {
            }
            else if (b)
            {
            }

        java:
            if (a) {
            }
            else if (b) {
            }


    case: OneAlternativeWithElse
        python:
            if a:
                pass
            elif b:
                pass
            else:
                c: int = k * 3

        c++:
            if (a)
            {
            }
            else if (b)
            {
            }
            else
            {
                int c = k * 3;
            }

        java:
            if (a) {
            }
            else if (b) {
            }
            else {
                int c = k * 3;
            }


    case: TwoAlternativesWithElseCompound
        python:
            b: int = 1
            k: int = 20
            if a:
                b = a * 3
                x += 15
            elif b:
                b = m * 3
                x += 15
            elif c:
                k = l * 3
                x += 15
            else:
                d *= 5
                x += 15

        c++:
            int b = 1;
            int k = 20;
            if (a)
            {
                b = a * 3;
                x += 15;
            }
            else if (b)
            {
                b = m * 3;
                x += 15;
            }
            else if (c)
            {
                k = l * 3;
                x += 15;
            }
            else
            {
                d *= 5;
                x += 15;
            }

        java:
            int b = 1;
            int k = 20;
            if (a) {
                b = a * 3;
                x += 15;
            }
            else if (b) {
                b = m * 3;
                x += 15;
            }
            else if (c) {
                k = l * 3;
                x += 15;
            }
            else {
                d *= 5;
                x += 15;
            }


    case: NestedAlternativesCompound
        python:
            if a > b:
                z += 15
                if x and y:
                    if x == 7:
                        x += 15
                    c += 15
                c += 15
            elif a < b:
                x += 15
                if x > 5:
                    if x != 7:
                        print("alarm")
                    else:
                        k += 15
                    c += 15
                y -= 15

        java:
            if (a > b) {
                z += 15;
                if (x && y) {
                    if (x == 7) {
                        x += 15;
                    }
                    c += 15;
                }
                c += 15;
            }
            else if (a < b) {
                x += 15;
                if (x > 5) {
                    if (x != 7) {
                        System.out.println("alarm");
                    }
                    else {
                        k += 15;
                    }
                    c += 15;
                }
                y -= 15;
            }

        c++:
            if (a > b)
            {
                z += 15;
                if (x && y)
                {
                    if (x == 7)
                    {
                        x += 15;
                    }
                    c += 15;
                }
                c += 15;
            }
            else if (a < b)
            {
                x += 15;
                if (x > 5)
                {
                    if (x != 7)
                    {
                        std::cout << "alarm" << std::endl;
                    } else
                    {
                        k += 15;
                    }
                    c += 15;
                }
                y -= 15;
            }


group: ForLoop
    case: MultipleInitializerAssignments
        main c++:
            for (i = 0, j = 3; i < j; i++, j--)
            {
            }

        java:
            for (i = 0, j = 3; i < j; i++, j--) {
            }


    case: RangeForLoop
        python:
            for i in range(0, 10, c):
                func(a)

        java:
            for (int i = 0; i < 10; i += c) {
                func(a);
            }

        c++:
            for (int i = 0; i < 10; i += c)
            {
                func(a);
            }


    case: RangeForLoopDefaultStep
        main python:
            for i in range(0, 3):
                func(i)

        java:
            for (int i = 0; i < 3; i++) {
                func(i);
            }

        c++:
            for (int i = 0; i < 3; i++)
            {
                func(i);
            }


    case: RangeForLoopWithExpressions
        isolated python:
            v: float = a * b * c
            while v < dx - 1:
                func(a)
                v += 1
            del v

        java:
            for (double v = a * b * c; v < dx - 1; v++) {
                func(a);
            }

        c++:
            for (double v = a * b * c; v < dx - 1; v++)
            {
                func(a);
            }


    case: ForEachLoop
        python:
            for a in b:
                x += 4

        java:
            for (Object a : b) {
                x += 4;
            }

        c++:
            for (auto a : b)
            {
                x += 4;
            }


    case: GeneralForTransformationTest
        java:
            for (int a = x; a != m; m = g()) {
                func(a, b);
            }

        isolated python:
            a: int = x
            while a != m:
                func(a, b)
                m = g()
            del a


    case: GeneralForWithMissingCondition
        java:
            for (int a = x; ; m = g()) {
                func(a, b);
            }

        isolated python:
            a: int = x
            while True:
                func(a, b)
                m = g()
            del a


    case: GeneralForWithMissingUpdate
        java:
            for (int a = x; a != m;) {
                func(a, b);
            }

        isolated python:
            a: int = x
            while a != m:
                func(a, b)
            del a


    case: GeneralForWithMissingUpdateWithContinue
        java:
            for (int a = x; a != m;) {
                func(a, b);
                if (a == k) {
                    continue;
                }
            }

        isolated python:
            a: int = x
            while a != m:
                func(a, b)
                if a == k:
                    continue
            del a


    case: GeneralForEmptyLoop
        java:
            for (;;) {
            }

        isolated python:
            while True:
                pass


    case: GeneralForWithContinueTransformationTest
        java:
            for (int a = x; a != m; m = g()) {
                func(a, b);
                if (a == m + 1) {
                    x++;
                    continue;
                }
            }

        isolated python:
            a: int = x
            while a != m:
                func(a, b)
                if a == m + 1:
                    x += 1
                    m = g()
                    continue
                m = g()
            del a



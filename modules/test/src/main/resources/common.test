    case: ContainsOp
        main python:
            list: List[int] = []
            x: int = 0
            a: bool = x in list

        java:
            java.util.ArrayList<Integer> list = new java.util.ArrayList<>(java.util.List.of());
            int x = 0;
            boolean a = list.contains(x);

        c++:
            std::vector<int> list = {};
            int x = 0;
            bool a = list.contains(x);

    case: ContainsNegativeOp
        main python:
            list: List[int] = []
            x: int = 0
            a: bool = x not in list

        java:
            java.util.ArrayList<Integer> list = new java.util.ArrayList<>(java.util.List.of());
            int x = 0;
            boolean a = !list.contains(x);

        c++:
            std::vector<int> list = {};
            int x = 0;
            bool a = !list.contains(x);

    case: ReferenceEqualOp
        main python:
            a: int = 0
            b: int = 0
            result: bool = a is b

        java:
            int a = 0;
            int b = 0;
            boolean result = a == b;

        c++:
            int a = 0;
            int b = 0;
            bool result = &a == &b;

    case: ReferenceNotEqualOp
        main python:
            a: int = 0
            b: int = 0
            result: bool = a is not b

        java:
            int a = 0;
            int b = 0;
            boolean result = a != b;

        c++:
            int a = 0;
            int b = 0;
            bool result = &a != &b;

